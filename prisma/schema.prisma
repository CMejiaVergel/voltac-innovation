// Plataforma de Innovacion GIMI/IDEX — Voltac Systems
//
// Nota sobre el motor: SQLite. La eleccion es deliberada — el despliegue es
// PM2 + Nginx sin Docker, y SQLite elimina un servicio del VPS. Migrar a
// Postgres es cambiar `provider` y regenerar migraciones.
//
// SQLite no soporta enums nativos: los estados se modelan como String con los
// valores validados en `src/lib/enums.ts` (unica fuente de verdad).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidad y acceso
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("MEMBER") // ADMIN | MEMBER
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  apiTokens     ApiToken[]
  pushSubs      PushSubscription[]
  memberships   Membership[]
  projects      Project[]          @relation("ProjectCreator")
  fragments     Fragment[]         @relation("FragmentAuthor")
  revisions     FragmentRevision[] @relation("RevisionAuthor")
  researchRuns  ResearchRun[]
  reviewedFrags Fragment[]         @relation("FragmentReviewer")
}

/// Token de acceso para agentes externos (MCP, scripts, integraciones).
///
/// Existe para que Claude Code —u otro cliente MCP— pueda actuar como agente
/// investigador contra la misma API guardada que usa la interfaz, sin abrir
/// una sesion de navegador ni compartir la contraseña de nadie.
///
/// Se guarda solo el SHA-256: el valor en claro se muestra una unica vez al
/// crearlo y despues no se puede recuperar.
model ApiToken {
  id        String    @id @default(cuid())
  /// SHA-256 del token en claro.
  tokenHash String    @unique
  /// Prefijo visible (vin_xxxxxxxx) para poder identificarlo en una lista.
  prefix    String
  label     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Solo lectura, o lectura y escritura.
  readOnly  Boolean   @default(false)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Suscripcion push de un navegador concreto (Web Push).
/// Una persona puede tener varias: telefono, portatil, tableta.
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String
  /// Para reconocerla en la lista de dispositivos del usuario.
  label     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Proyectos
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  /// Empresa dueña del reto (ej. "Cabot Corporation — planta Cartagena")
  company String?
  /// Programa o convocatoria (ej. "Caribe Innova 2026")
  program String?
  /// ACTIVE | ARCHIVED | TRASHED
  ///
  /// Borrar un proyecto destruye meses de trabajo del equipo, asi que la
  /// interfaz solo lo manda a la papelera. El borrado real exige vaciarla, que
  /// es un segundo acto deliberado.
  status    String    @default("ACTIVE")
  trashedAt DateTime?

  /// Modelo de OpenRouter que usa el agente en este proyecto. Vacio = el que
  /// diga OPENROUTER_MODEL en el entorno.
  agentModel     String  @default("")
  /// Si el agente puede buscar en la web. Es lo que mas cuesta por corrida.
  agentWebSearch Boolean @default(true)

  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brief         Brief?
  members       Membership[]
  maps          BomMap[]
  sources       Source[]
  openQuestions OpenQuestion[]
  researchRuns  ResearchRun[]
}

model Membership {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("EDITOR") // OWNER | EDITOR | VIEWER
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 2 IDEX — Configurar (Set Up)
// Corresponde a las plantillas oficiales GIMI: "Diseñe el Desafio de la
// Innovacion" (CG.pdf, ej. 2.1.1 y 2.1.3) e "Intencion de Innovar".
// Todo esto es el insumo que recibe el agente investigador.
// ─────────────────────────────────────────────────────────────────────────────

model Brief {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Reto textual tal como lo entrego la empresa. Se cita literal, no se parafrasea.
  challengeText String @default("")
  /// Ejercicio 2.1.1 — que problema se busca resolver
  problema String @default("")
  /// Ejercicio 2.1.1 — por que es motivante / relevante
  porQueMotivante String @default("")
  /// Ejercicio 2.1.3 — cual es la meta (brecha a cerrar y para cuando)
  meta String @default("")

  /// Ejercicio 2.1.3 — checklist de a que se refieren las soluciones (claves de SOLUTION_FOCI)
  solutionFoci String @default("[]") // JSON string[]

  /// Lista literal de la empresa: que hacer / que evitar
  queHacer  String @default("[]") // JSON string[]
  queEvitar String @default("[]") // JSON string[]
  /// Restricciones duras (economicas, legales, tecnicas)
  restricciones String @default("")

  /// Intencion de Innovar (marco GIMI: razon de cambio / brecha / perfil de inversion)
  razonDeCambio     String @default("") // CEO | ENTORNO | COMPETENCIA | CLIENTES | OTRO
  brechaCrecimiento String @default("")
  perfilInversion   String @default("") // LOCAL_GLOBAL | INCREMENTAL_AVANCE | NUCLEO_LEJOS | PEQUENO_GRAN | OTRO

  /// Terminos, empresas o regiones que el agente debe priorizar o excluir
  agentHints   String @default("")
  agentExclude String @default("")

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 3 IDEX — Divergir. El Mapa de Oportunidades de Negocio.
//
// La plantilla es DATO, no codigo: filas y columnas se guardan como JSON para
// que existan la 5x5 del taller de Caribe Innova y la 5x2 oficial de DV.pdf
// sin duplicar el motor.
// ─────────────────────────────────────────────────────────────────────────────

model MapTemplate {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String  @default("")
  /// Plantilla del sistema: no editable ni borrable desde la UI.
  isSystem    Boolean @default(false)

  /// JSON: [{ id, name, facets, color }]
  rows String
  /// JSON: [{ id, name, question, hint }]
  cols String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maps BomMap[]
}

model BomMap {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  templateId String
  template   MapTemplate @relation(fields: [templateId], references: [id])

  name      String   @default("Mapa de Oportunidades de Negocio")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragments    Fragment[]
  researchRuns ResearchRun[]

  @@index([projectId])
}

/// Un fragmento es una observacion cruda: una sola idea, sin conclusion.
/// REGLA METODOLOGICA: aqui NO se escriben insights ni se etiquetan fragmentos
/// con el insight al que pertenecen. Los insights se leen despues, sobre el
/// mapa lleno (agenda oficial: BOM primero, insights despues).
model Fragment {
  id    String @id @default(cuid())
  mapId String
  map   BomMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  /// Coordenada en la plantilla. Son ids de la plantilla, no claves foraneas:
  /// la plantilla es JSON. La integridad se valida en la capa de servicio.
  rowId String
  colId String

  text String
  /// Orden dentro de la celda. Lo fija el equipo arrastrando: dentro de una
  /// celda el orden es una decision de lectura, no un detalle.
  position Int @default(0)

  /// Fuera de la vista sin borrarse. Para fragmentos que no aportan a la
  /// conversacion de hoy pero que el equipo no quiere perder.
  hidden Boolean @default(false)

  /// VERIFIED | TO_CONFIRM | ASSUMPTION
  verification String @default("TO_CONFIRM")
  /// ACCEPTED | PROPOSED | REJECTED — los del agente entran como PROPOSED.
  reviewState String @default("ACCEPTED")
  /// HUMAN | AGENT
  origin String @default("HUMAN")

  sourceUrl      String?
  sourceCitation String?
  sourceId       String?
  source         Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  /// Por que el agente lo ubico en esta celda. Se muestra en la cola de revision.
  agentRationale String?

  authorId String?
  author   User?   @relation("FragmentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?     @relation("FragmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  researchRunId String?
  researchRun   ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions FragmentRevision[]

  @@index([mapId, rowId, colId])
  @@index([mapId, reviewState])
}

/// Historial por fragmento. Se escribe una fila por cada cambio.
///
/// La relacion es opcional a proposito: cuando se borra un fragmento, su
/// historial NO se va con el. `fragmentId` queda en null y la fila sobrevive
/// con el texto y la celda que tenia, para que el borrado quede auditado. Por
/// eso tambien se guarda `mapId` aqui: sin el, una revision huerfana no se
/// podria ubicar en ningun mapa.
model FragmentRevision {
  id         String    @id @default(cuid())
  mapId      String    @default("")
  fragmentId String?
  fragment   Fragment? @relation(fields: [fragmentId], references: [id], onDelete: SetNull)

  /// CREATE | EDIT | MOVE | VERIFY | ACCEPT | REJECT | DELETE
  action String

  text         String?
  rowId        String?
  colId        String?
  verification String?
  reviewState  String?
  note         String?

  editedById String?
  editedBy   User?   @relation("RevisionAuthor", fields: [editedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([fragmentId])
  @@index([mapId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trazabilidad
// ─────────────────────────────────────────────────────────────────────────────

/// Bibliografia central del proyecto: toda afirmacion debe poder rastrearse.
model Source {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title     String
  url       String?
  publisher String?
  year      String?
  note      String  @default("")
  /// HUMAN | AGENT
  addedBy   String  @default("HUMAN")

  createdAt DateTime @default(now())

  fragments Fragment[]

  @@index([projectId])
}

/// Banco de preguntas pendientes para la empresa. El agente escribe aqui en vez
/// de inventar un dato que no pudo verificar.
model OpenQuestion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  text    String
  askedTo String @default("")
  /// OPEN | ANSWERED | DISCARDED
  status  String @default("OPEN")
  answer  String @default("")
  /// HUMAN | AGENT
  origin  String @default("HUMAN")
  /// Orden manual dentro del banco. El equipo decide que preguntar primero:
  /// no todas valen lo mismo en una reunion de media hora con la empresa.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agente investigador
// ─────────────────────────────────────────────────────────────────────────────

model ResearchRun {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mapId     String
  map       BomMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id])

  /// PENDING | RUNNING | DONE | ERROR
  status String @default("PENDING")

  /// JSON con el alcance pedido: celdas objetivo, fragmentos por celda, notas.
  scope String @default("{}")

  model        String @default("")
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  webSearches  Int    @default(0)
  /// Coste real en USD reportado por OpenRouter. null si no lo informo.
  costUsd      Float?
  /// Texto crudo devuelto por el modelo, para auditar que propuso y por que.
  rawResponse String?
  error       String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  fragments Fragment[]

  @@index([projectId])
}
