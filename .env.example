# ── Base de datos ────────────────────────────────────────────────────────────
# SQLite. En el VPS apunta a una ruta absoluta fuera del directorio de deploy
# para que un redeploy no la toque:  file:/var/lib/voltac-innovation/prod.db
DATABASE_URL="file:./dev.db"

# ── Sesiones ─────────────────────────────────────────────────────────────────
# Secreto para firmar cookies de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio"

# ── Agente investigador (OpenRouter) ─────────────────────────────────────────
# Una sola clave da acceso a cientos de modelos: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Modelo por defecto. Cada proyecto puede cambiarlo desde la interfaz sin
# tocar esto. Ver la guia de modelos en docs/AGENTE-MODELOS.md
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Resultados de busqueda web por corrida. Es la parte cara: se cobra por
# resultado, aparte de los tokens. Subelo solo si los fragmentos salen pobres.
AGENT_MAX_WEB_RESULTS="8"

# Atribucion de trafico en OpenRouter (opcional, aparece en su panel).
OPENROUTER_SITE_URL="https://innovation.voltac.com.co"
OPENROUTER_APP_NAME="Voltac Innovacion"

# ── Notificaciones push (Web Push / VAPID) ───────────────────────────────────
# Generar el par UNA sola vez con:  npx web-push generate-vapid-keys
# Si se cambian, todos los dispositivos suscritos dejan de recibir avisos.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contabilidadvoltac@gmail.com"

# ── Semilla del administrador inicial (solo se usa en `npm run seed`) ────────
SEED_ADMIN_EMAIL="contabilidadvoltac@gmail.com"
SEED_ADMIN_NAME="Carlos Mejia"
SEED_ADMIN_PASSWORD="cambiar-en-el-primer-login"

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
